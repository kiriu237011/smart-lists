// =============================================================================
// Конфигурация генератора Prisma Client
// =============================================================================

/// Генератор создаёт TypeScript-клиент (`@prisma/client`) на основе этой схемы.
/// Запускается командой: `npx prisma generate`
generator client {
  provider        = "prisma-client-js"
  // relationJoins: позволяет relationLoadStrategy: "join" — вложенные связи
  // грузятся ОДНИМ SQL-запросом (LATERAL JOIN) вместо серии последовательных.
  // Критично при удалённой БД: каждый лишний запрос = +RTT до Сингапура.
  previewFeatures = ["relationJoins"]
}

// =============================================================================
// Источник данных (PostgreSQL)
// =============================================================================

/// Подключение к базе данных PostgreSQL.
/// URL хранится в переменной окружения DATABASE_URL (файл .env.local).
/// Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// МОДЕЛИ AUTH.JS
// Эти модели требуются библиотекой Auth.js (NextAuth v5) и управляются
// автоматически через PrismaAdapter. Не удалять и не переименовывать поля!
// =============================================================================

/// Пользователь приложения.
/// Создаётся Auth.js автоматически при первом входе через Google.
/// Расширена бизнес-связями списков, пространств и общего доступа.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Связанные OAuth-аккаунты пользователя (например, Google).
  accounts Account[]

  /// Активные сессии пользователя.
  sessions Session[]

  // -------------------------------------------------------------------------
  // Наши бизнес-поля (добавлены поверх базовой схемы Auth.js)
  // -------------------------------------------------------------------------

  /// Списки, созданные этим пользователем (он — владелец).
  myLists List[] @relation("Owner")

  /// Персональные пространства пользователя.
  spaces Space[]

  /// Явные записи общего доступа к спискам с размещением в пространстве.
  receivedListShares ListShare[]

  /// Записи, добавленные этим пользователем.
  addedItems Item[] @relation("AddedItems")

  /// Группы списков, созданные этим пользователем.
  listGroups ListGroup[]

  /// Счётчики запросов к AI-инсайтам (для rate limiting).
  aiInsightUsage AiInsightUsage[]

  /// Вложения, загруженные этим пользователем.
  /// При удалении аккаунта связь обнуляется (onDelete: SetNull) — файл
  /// остаётся в расшаренном списке, но атрибуция становится «неизвестный».
  uploadedAttachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// OAuth-аккаунт, привязанный к пользователю.
/// Хранит токены доступа от провайдера (Google и т.д.).
/// Составной первичный ключ: provider + providerAccountId.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

/// Сессия пользователя, управляемая Auth.js.
/// Хранит токен сессии в cookie. Автоматически удаляется по истечении `expires`.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Токен для верификации email (используется при passwordless-входе).
/// В текущей реализации не применяется (вход только через Google).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// =============================================================================
// БИЗНЕС-МОДЕЛИ ПРИЛОЖЕНИЯ
// =============================================================================

/// Список.
/// Может принадлежать одному владельцу и быть общим для нескольких пользователей.
model List {
  id    String @id @default(cuid())
  title String

  /// Общая текстовая заметка списка. null означает, что заметки нет.
  note String?

  /// Версия заметки для защиты от потери изменений при совместном редактировании.
  noteVersion Int @default(0)

  /// Время последнего изменения заметки. Используется при отборе контекста для AI.
  noteUpdatedAt DateTime?

  /// Цвет иконки списка (зарезервировано для будущей функциональности).
  color String @default("blue")

  // ---- Связь "Владелец" (Many-to-One) ----

  /// ID пользователя-владельца. Используется для проверки прав в Server Actions.
  ownerId String

  /// Объект владельца. Каскадное удаление: при удалении пользователя его списки тоже удаляются.
  owner User @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Пространство владельца.
  spaceId String

  /// Составная связь не позволяет привязать список к пространству другого пользователя.
  space Space @relation("SpaceLists", fields: [spaceId, ownerId], references: [id, userId], onDelete: Cascade)

  // ---- Связь "Записи" (One-to-Many) ----

  /// Записи, входящие в этот список.
  items Item[]

  // ---- Связь "Общий доступ" ----

  /// Явная модель общего доступа с размещением в пространстве получателя.
  shares ListShare[]

  /// Персональные размещения списка в группах пользователей.
  /// Порядок хранится на самой связи: один список может занимать разные места
  /// в разных группах и у разных пользователей.
  groupMemberships ListGroupMembership[]

  // ---- Связь "Вложения" (One-to-Many) ----

  /// Файлы, прикреплённые к списку (изображения и документы в S3).
  /// Вложение принадлежит списку целиком, а не отдельной записи.
  files Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Postgres не индексирует FK-колонки автоматически. По ownerId фильтрует
  // главный запрос выборки списков (он выполняется при каждом рендере страницы).
  @@index([ownerId])
  @@index([spaceId])
}

/// Группа списков, созданная пользователем для личной организации.
/// Группы персональные: каждый пользователь видит только свои группы.
/// Список может входить в несколько групп разных пользователей (M2M).
model ListGroup {
  id String @id @default(cuid())

  /// Название группы (например: "Работа", "Дом", "Поход").
  name String

  /// ID пользователя-владельца группы.
  userId String

  /// Пользователь-владелец. Каскадное удаление: при удалении пользователя его группы тоже удаляются.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Пространство группы.
  spaceId String

  /// Составная связь гарантирует, что пространство принадлежит владельцу группы.
  space Space @relation(fields: [spaceId, userId], references: [id, userId], onDelete: Cascade)

  /// Упорядоченные размещения списков в этой группе.
  listMemberships ListGroupMembership[]

  /// Позиция группы среди пользовательских групп текущего пространства.
  /// Дробное значение позволяет переставлять одну группу между соседями без
  /// перенумерации всех остальных при каждом перетаскивании.
  position Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Индекс FK: выборка групп пользователя выполняется при каждом рендере страницы.
  @@index([userId])
  @@index([spaceId])
  @@index([userId, spaceId, position])
}

/// Персональное размещение списка в группе.
///
/// Явная модель отображается на прежнюю implicit M2M-таблицу
/// `_ListGroupMembers`, поэтому миграция добавляет порядок без потери уже
/// существующих связей.
model ListGroupMembership {
  /// ID списка. В существующей таблице Prisma называла колонку `A`.
  listId String @map("A")

  /// ID группы. В существующей таблице Prisma называла колонку `B`.
  groupId String @map("B")

  /// Относительный порядок списка внутри конкретной группы.
  /// Дробная позиция позволяет обычно обновлять только одну строку.
  position Float

  list  List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  group ListGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([listId, groupId], map: "_ListGroupMembers_AB_pkey")
  @@index([groupId], map: "_ListGroupMembers_B_index")
  @@index([groupId, position], map: "_ListGroupMembers_groupId_position_idx")
  @@map("_ListGroupMembers")
}

/// Персональное пространство пользователя — верхний уровень организации списков.
/// Default-пространство существует всегда и не учитывается в лимите пяти дополнительных.
model Space {
  id String @id @default(cuid())

  /// Пользовательское имя. null у непереименованного default-пространства:
  /// интерфейс показывает локализованное название «Основное».
  name String?

  /// Нормализованное имя для регистронезависимой уникальности.
  normalizedName String?

  isDefault Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  lists          List[]      @relation("SpaceLists")
  groups         ListGroup[]
  receivedShares ListShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, normalizedName])
  // Нужен для составных FK: список/группа/share не могут ссылаться на чужое пространство.
  @@unique([id, userId])
  @@index([userId, isDefault])
}

/// Явный общий доступ к списку и его размещение у получателя.
/// Один список может быть доступен пользователю только в одном его пространстве.
model ListShare {
  listId  String
  userId  String
  spaceId String
  role    ListShareRole @default(EDITOR)

  list  List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId, userId], references: [id, userId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([listId, userId])
  @@index([userId, spaceId])
  @@index([spaceId])
}

enum ListShareRole {
  EDITOR
}

/// Запись внутри списка.
model Item {
  id String @id @default(cuid())

  /// Дополнительная текстовая заметка к записи. null означает, что заметки нет.
  note String?

  /// Версия заметки для защиты от потери изменений при совместном редактировании.
  noteVersion Int @default(0)

  /// Время последнего изменения заметки. Используется при отборе контекста для AI.
  noteUpdatedAt DateTime?

  /// Название записи (например, "Молоко 1л").
  name String

  /// Статус покупки: false — не куплен, true — куплен (зачёркнут в UI).
  isCompleted Boolean @default(false)

  /// Относительный порядок записи внутри списка. Значимо только сравнение
  /// позиций между собой, абсолютная величина смысла не имеет.
  ///
  /// Тип дробный намеренно: перемещение записи вычисляет середину между
  /// позициями новых соседей и пишет ОДНУ строку вместо перенумерации всего
  /// списка. Это важно и для скорости (БД удалённая), и для совместной работы:
  /// два участника, двигающие разные записи одновременно, не затирают соседей
  /// друг друга. Худший исход гонки — две близкие позиции, а не сломанный
  /// порядок; порядок доопределяет тайбрейк по createdAt и id.
  ///
  /// Видимый номер записи здесь НЕ хранится: он вычисляется при рендере как
  /// индекс среди невыполненных записей. Поэтому удаление и отметка о
  /// выполнении не требуют перенумерации вообще.
  position Float

  // ---- Связь с List (Many-to-One) ----

  /// ID списка, которому принадлежит запись.
  listId String

  /// Родительский список. Каскадное удаление: при удалении списка все его записи тоже удаляются.
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  // ---- Кто добавил запись ----

  /// ID пользователя, добавившего запись (опционально: NULL для старых записей).
  addedById String?

  /// Пользователь, добавивший запись. При удалении пользователя поле обнуляется.
  addedBy User? @relation("AddedItems", fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Индексы FK (как у Attachment): listId — выборка записей списка при каждом
  // рендере и каскадное удаление; addedById — SetNull при удалении аккаунта.
  //
  // Составной [listId, position] обслуживает основную выборку «записи списка
  // в порядке отображения». Отдельный индекс по listId не нужен: Postgres
  // использует составной индекс и для запросов по одному лишь префиксу.
  @@index([listId, position])
  @@index([addedById])
}

// =============================================================================
// WHITELIST
// =============================================================================

/// Email-адреса, которым разрешён вход в приложение.
/// Управляется напрямую в БД — без необходимости деплоя.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// =============================================================================
// НАСТРОЙКИ ПРИЛОЖЕНИЯ
// =============================================================================

/// Настройки приложения в формате «ключ — значение».
/// Управляются напрямую в БД — без деплоя (тот же подход, что и AllowedEmail).
///
/// Используемые ключи:
///   - "guestModeEnabled": "true" — гостевой вход разрешён;
///     любое другое значение или отсутствие строки — запрещён.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// =============================================================================
// RATE LIMITING
// =============================================================================

/// Счётчик запросов к AI-инсайтам — один ряд на пользователя в день.
/// Тип поля `date` — DateTime; нормализация до UTC-полуночи строго в Server Action
/// (setUTCHours(0,0,0,0)). Postgres не накладывает ограничений на timestamp.
/// Уникальный индекс (userId, date) гарантирует атомарность upsert.
model AiInsightUsage {
  id     String @id @default(cuid())
  userId String

  /// Дата в UTC (нормализована до 00:00:00.000 в Server Action перед записью).
  date DateTime

  /// Количество запросов за этот день.
  count Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// =============================================================================
// ВЛОЖЕНИЯ К СПИСКАМ (S3)
// =============================================================================

/// Категория файла — определяет иконку в UI и набор допустимых форматов.
/// Это UI-концерн; реальный MIME-тип хранится отдельно в `Attachment.contentType`.
enum FileCategory {
  IMAGE
  DOCUMENT
}

/// Статус вложения в two-phase-загрузке (PENDING → UPLOADED).
/// Недозалитый файл (PENDING) не виден в UI, но считается в квоту;
/// зависшие PENDING-строки убирает ленивая уборка в `requestUpload`.
enum AttachmentStatus {
  PENDING // строка создана, файл ещё не подтверждён через HeadObject
  UPLOADED // файл залит в S3 и проверен на сервере
}

/// Вложение к списку. Сами байты хранятся в приватном S3-бакете,
/// здесь — только метаданные. Адресуется по `key` (object key в S3),
/// а не по полному URL: URL завязан на bucket/регион и протухает (presigned),
/// тогда как key стабилен.
model Attachment {
  id String @id @default(cuid())

  /// Object key в S3 по схеме `lists/{listId}/{cuid}.ext`.
  /// Генерируется сервером — это исключает коллизии имён, юникод-сюрпризы
  /// и path-traversal. `@unique` — страховка от бага в генераторе ключей.
  key String @unique

  /// Оригинальное имя файла — только для показа человеку.
  name String

  /// Категория файла (иконка + набор форматов).
  type FileCategory

  /// Реальный MIME-тип (image/png, application/pdf) — для корректной отдачи
  /// и валидации. Отличается от `type`: `type` — UI, `contentType` — безопасность.
  contentType String

  /// Размер файла в байтах (UI + валидация + квота).
  size Int

  /// Статус two-phase-загрузки. По умолчанию PENDING до подтверждения.
  status AttachmentStatus @default(PENDING)

  // ---- Связь со списком (Many-to-One) ----

  /// ID списка, которому принадлежит вложение.
  listId String

  /// Родительский список. Каскадное удаление: при удалении списка строки
  /// вложений тоже удаляются. ВАЖНО: каскад убирает только строки в БД —
  /// объекты в S3 нужно удалять отдельно (см. deleteList).
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  // ---- Кто загрузил (Many-to-One, опционально) ----

  /// ID загрузившего пользователя. Nullable — следствие onDelete: SetNull.
  uploadedById String?

  /// Пользователь, загрузивший файл. При удалении аккаунта — null
  /// («загрузил неизвестный»), файл остаётся в расшаренном списке.
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Postgres не индексирует FK-колонки автоматически; индексы нужны
  // для выборок по списку/пользователю и ускоряют каскадное удаление.
  @@index([listId])
  @@index([uploadedById])
}
