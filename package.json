{
  "name": "smart-lists",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "prisma migrate deploy && next build",
    "migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:db": "docker compose -f docker-compose.test.yml up -d --wait postgres-test",
    "test:integration:db:down": "docker compose -f docker-compose.test.yml down",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:db": "docker compose -f docker-compose.test.yml --profile e2e up -d --wait postgres-e2e",
    "test:e2e:db:down": "docker compose -f docker-compose.test.yml --profile e2e down",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-presigned-post": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pusher": "^5.3.2",
    "pusher-js": "^8.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch@3": "3.1.3",
    "minimatch@9": "9.0.7",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.5",
    "@babel/core": "^7.29.6"
  }
}
